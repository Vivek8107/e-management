// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Defaulting to SQLite for zero-setup local instant execution.
// To deploy to Supabase/Neon PostgreSQL:
// Change provider to "postgresql" and set url = env("DATABASE_URL")
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String        @id @default(uuid())
  phoneNumber     String        @unique
  name            String?
  businessName    String
  businessAddress String?
  upiId           String?
  gstNumber       String?
  currency        String        @default("INR")
  locale          String        @default("hi") // "hi" for Hindi/Hinglish, "en" for English
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  customers       Customer[]
  transactions    Transaction[]
  invoices        Invoice[]
}

model Customer {
  id             String        @id @default(uuid())
  userId         String
  name           String
  phoneNumber    String
  address        String?
  category       String        @default("CLIENT") // "CLIENT", "LABOUR", "TRANSPORT", "TRAVEL", "SUPPLIER"
  currentBalance Float         @default(0.0) // Positive = Udhaar (You'll get), Negative = Advance (You'll give)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions   Transaction[]
  invoices       Invoice[]

  @@index([userId, phoneNumber])
}

model Transaction {
  id          String    @id @default(uuid())
  userId      String
  customerId  String
  type        String    // "CREDIT_GIVEN" (Aapne diye / Udhaar) | "PAYMENT_GOT" (Aapko mile / Jama)
  amount      Float
  note        String?
  date        DateTime  @default(now())
  invoiceId   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  invoice     Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([userId, customerId, date])
}

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String
  userId        String
  customerId    String?
  customerName  String?
  customerPhone String?

  subtotal      Float
  discount      Float         @default(0.0)
  taxRate       Float         @default(0.0)
  taxAmount     Float         @default(0.0)
  totalAmount   Float

  paymentStatus String        @default("PAID") // "PAID", "UNPAID", "PARTIAL"
  paymentMode   String        @default("CASH") // "CASH", "UPI", "KHATA", "OTHER"
  notes         String?

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer      Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items         InvoiceItem[]
  transactions  Transaction[]

  @@unique([userId, invoiceNumber])
  @@index([userId, createdAt])
}

model InvoiceItem {
  id         String   @id @default(uuid())
  invoiceId  String
  itemName   String
  quantity   Float    @default(1.0)
  unit       String   @default("pcs") // pcs, kg, g, l, packet, etc.
  unitPrice  Float
  totalPrice Float
  createdAt  DateTime @default(now())

  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}
